# Copy this file to .env and fill in your keys

# ── Apify (review scraper) ────────────────────────────────────────────────────
APIFY_API_TOKEN=your_apify_token_here

# ── Model A — Groq (primary analyst) ─────────────────────────────────────────
# Free tier: https://console.groq.com
# llama-3.3-70b-versatile : 100K TPD, 14,400 TPM — deep sentiment analysis
# llama-3.1-8b-instant    : 500K TPD,  6,000 TPM — guardrail + explanation
GROQ_API_KEY=your_groq_api_key_here
STRONG_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant

# ── Model B — Groq llama-3.1-8b-instant (independent verifier) ─────────────
# Uses llama-3.1-8b-instant for verification (most reliable JSON on Groq)
# Large quota: 500K TPD, 6,000 TPM (shared with guardrail, plenty for both)
# Independence through: different stage, different context, cross-validation role
VERIFIER_MODEL=llama-3.1-8b-instant

# ── Final Verdict & Explanation Model ─────────────────────────────────────────
# Model used to generate the final review summary, verdict prose, pros, cons, and tips
# Options on Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it, deepseek-r1-distill-llama-70b
VERDICT_MODEL=llama-3.3-70b-versatile

# Set to true to block results if verification is unavailable
REQUIRE_VERIFICATION=false

# ── Performance / quota ───────────────────────────────────────────────────────
# Concurrent sentiment batches (each reserves ~6K tokens against the 70B bucket)
SENTIMENT_MAX_WORKERS=3
# Bypass the client-side token bucket entirely (paid Groq tiers, or debugging)
RATE_LIMIT_DISABLED=false
# Fallback wait in seconds when Groq rate-limits without a Retry-After hint
RATE_LIMIT_BACKOFF=5

# ── Caching / logging ─────────────────────────────────────────────────────────
CACHE_DIR=cache
CACHE_TTL_HOURS=168
LOG_LEVEL=INFO
# Ask Groq for server-side JSON mode where the model supports it
USE_JSON_MODE=true
