# Copy to .env. Keys remain server-side; never add VITE_ prefixes.
APIFY_API_TOKEN=your_apify_token_here
GROQ_API_KEY=your_groq_api_key_here

# Optional role overrides. If unset, select from the active Groq model catalog:
# Analyst/verdict prefer GPT-OSS 120B; guardrail prefers GPT-OSS 20B.
# Verifier prefers qwen/qwen3.8-27b only if its EXACT ID exists, then
# qwen/qwen3-32b, then GPT-OSS 20B/120B and supported Llama fallbacks.
# These are availability preferences, NOT a guarantee of free access or quota.
# Check /api/models for effective roles and catalog verification status.
# STRONG_MODEL=openai/gpt-oss-120b
# FAST_MODEL=openai/gpt-oss-20b
# VERIFIER_MODEL=openai/gpt-oss-20b
# VERDICT_MODEL=openai/gpt-oss-120b

# A free-tier key still has model-specific limits. Catalog availability does not
# expose billing eligibility. If quota is exhausted, wait or change the override.
REQUIRE_VERIFICATION=false
